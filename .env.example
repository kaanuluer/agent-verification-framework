# Agent Verification Framework - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Flask Environment
FLASK_ENV=production
DEBUG=false

# Security Keys (REQUIRED in production)
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secret-key-change-this-in-production

# API Authentication (REQUIRED in production)
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
API_KEY=your-api-key-change-this-in-production

# Server Configuration
HOST=127.0.0.1
PORT=5000

# Security Settings
REQUIRE_HTTPS=true
SESSION_COOKIE_SECURE=true

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-app.com,https://api.your-app.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# Request Limits
MAX_CONTENT_LENGTH=10485760  # 10MB in bytes

# Logging
LOG_LEVEL=INFO
