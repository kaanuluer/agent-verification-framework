{
  "api": {
    "version": "0.2.0",
    "title": "Agent Verification Framework API",
    "description": "REST API for verifying agent actions and intents",
    "host": "0.0.0.0",
    "port": 5000,
    "debug": false
  },
  "authentication": {
    "enabled": true,
    "require_api_key": true,
    "allow_anonymous": false
  },
  "rate_limiting": {
    "enabled": true,
    "requests_per_minute": 100,
    "requests_per_hour": 1000
  },
  "session": {
    "default_level": "STANDARD",
    "max_sessions_per_user": 10,
    "session_timeout_minutes": 60,
    "auto_cleanup": true
  },
  "logging": {
    "level": "INFO",
    "format": "json",
    "output": "stdout"
  },
  "cors": {
    "enabled": true,
    "origins": ["*"],
    "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allow_headers": ["Content-Type", "Authorization", "X-API-Key"]
  },
  "security": {
    "require_https": false,
    "api_key_header": "X-API-Key",
    "max_request_size_mb": 10
  }
}
